{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spacerockscabinet.example/contracts/coa-batch-input-v1.schema.json",
  "title": "coa-batch-input-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractName",
    "schemaVersion",
    "issuer",
    "sourceSha256",
    "specimens"
  ],
  "properties": {
    "contractName": {
      "const": "coa-batch-input-v1"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "issuer": {
      "const": "The Spacerocks Cabinet"
    },
    "sourceSha256": {
      "$ref": "#/$defs/sourceSha256"
    },
    "specimens": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "$ref": "#/$defs/specimen"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceSha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledger",
        "meteorites",
        "collection",
        "saleSpecimens",
        "assertions"
      ],
      "properties": {
        "ledger": {
          "$ref": "#/$defs/sha256"
        },
        "meteorites": {
          "$ref": "#/$defs/sha256"
        },
        "collection": {
          "$ref": "#/$defs/sha256"
        },
        "saleSpecimens": {
          "$ref": "#/$defs/sha256"
        },
        "assertions": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "officialIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "classification",
        "metbullCode",
        "sourceUrl"
      ],
      "properties": {
        "kind": {
          "const": "official-meteorite"
        },
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "metbullCode": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "sourceUrl": {
          "type": "string",
          "pattern": "^https://www\\.lpi\\.usra\\.edu/meteor/metbull\\.php\\?code=[0-9]+$"
        }
      }
    },
    "unclassifiedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "classification"
      ],
      "properties": {
        "kind": {
          "const": "unclassified-meteorite"
        },
        "classification": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "impactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "classification"
      ],
      "properties": {
        "kind": {
          "const": "cataloged-impact-material"
        },
        "classification": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "occurrence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "date",
            "datePrecision"
          ],
          "properties": {
            "kind": {
              "enum": [
                "fall",
                "find"
              ]
            },
            "date": {
              "type": "string",
              "pattern": "^[0-9]{4}$"
            },
            "datePrecision": {
              "const": "year"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "date",
            "datePrecision"
          ],
          "properties": {
            "kind": {
              "const": "fall"
            },
            "date": {
              "type": "string",
              "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
            },
            "datePrecision": {
              "const": "day"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "date",
            "datePrecision"
          ],
          "properties": {
            "kind": {
              "enum": [
                "impact-site-association",
                "unknown"
              ]
            },
            "date": {
              "type": "null"
            },
            "datePrecision": {
              "const": "unknown"
            }
          }
        }
      ]
    },
    "location": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "precision"
          ],
          "properties": {
            "name": {
              "type": "null"
            },
            "precision": {
              "const": "unknown"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "precision"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "precision": {
              "enum": [
                "locality",
                "region",
                "country"
              ]
            }
          }
        }
      ]
    },
    "photograph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relativePath",
        "mediaType",
        "bytes",
        "sha256",
        "primary",
        "sourceAltText",
        "representation",
        "disclosure"
      ],
      "properties": {
        "relativePath": {
          "type": "string",
          "pattern": "^assets/(?:collection|sale-specimens)/[a-z0-9][a-z0-9.-]*\\.jpg$"
        },
        "mediaType": {
          "const": "image/jpeg"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "primary": {
          "type": "boolean"
        },
        "sourceAltText": {
          "type": "string",
          "minLength": 1
        },
        "representation": {
          "const": "prepared-catalog-image"
        },
        "disclosure": {
          "const": "Prepared catalog image; not an original camera file."
        }
      }
    },
    "specimen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specimenId",
        "stableId",
        "catalogNumber",
        "listingType",
        "name",
        "objectCategory",
        "identity",
        "mass",
        "dimensions",
        "provenance",
        "description",
        "occurrence",
        "location",
        "photographs"
      ],
      "properties": {
        "specimenId": {
          "type": "string",
          "pattern": "^Specimen [0-9]{3}$"
        },
        "stableId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "catalogNumber": {
          "type": "string",
          "pattern": "^Specimen [0-9]{3,}$"
        },
        "listingType": {
          "enum": [
            "collection",
            "sale"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "objectCategory": {
          "enum": [
            "meteorite",
            "impact-material"
          ]
        },
        "identity": {
          "oneOf": [
            {
              "$ref": "#/$defs/officialIdentity"
            },
            {
              "$ref": "#/$defs/unclassifiedIdentity"
            },
            {
              "$ref": "#/$defs/impactIdentity"
            }
          ]
        },
        "mass": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "asRecordedGrams"
          ],
          "properties": {
            "asRecordedGrams": {
              "type": "string",
              "pattern": "^(?:(?:[0-9]*[1-9][0-9]*)(?:\\.[0-9]+)?|[0-9]*\\.[0-9]*[1-9][0-9]*)$"
            }
          }
        },
        "dimensions": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "provenance": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "occurrence": {
          "$ref": "#/$defs/occurrence"
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "photographs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/photograph"
          }
        }
      }
    }
  }
}
